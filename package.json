{
	"name": "flying-worker",
	"version": "0.0.1",
	"description": "A application development framework for Cloudflare Worker",
	"type": "module",
	"exports": {
		"./auth": {
			"types": "./dist/auth/index.d.ts",
			"import": "./dist/auth/index.js"
		},
		"./cookie": {
			"types": "./dist/cookie/index.d.ts",
			"import": "./dist/cookie/index.js",
			"require": "./dist/cookie/index.cjs"
		},
		"./core": {
			"types": "./dist/core/index.d.ts",
			"import": "./dist/core/index.js"
		},
		"./database": {
			"types": "./dist/database/index.d.ts",
			"import": "./dist/database/index.js"
		},
		"./event": {
			"types": "./dist/event/index.d.ts",
			"import": "./dist/event/index.js"
		},
		"./kv": {
			"types": "./dist/kv/index.d.ts",
			"import": "./dist/kv/index.js"
		},
		"./middlewares": {
			"types": "./dist/middlewares/index.d.ts",
			"import": "./dist/middlewares/index.js"
		},
		"./queue": {
			"types": "./dist/queue/index.d.ts",
			"import": "./dist/queue/index.js"
		},
		"./route": {
			"types": "./dist/route/index.d.ts",
			"import": "./dist/route/index.js"
		},
		"./session": {
			"types": "./dist/session/index.d.ts",
			"import": "./dist/session/index.js"
		},
		"./supports": {
			"types": "./dist/supports/index.d.ts",
			"import": "./dist/supports/index.js"
		},
		"./types": {
			"types": "./dist/type-declaration/index.d.ts",
			"import": "./dist/type-declaration/index.js"
		},
		"./zod-schema": {
			"types": "./dist/zod-schema/index.d.ts",
			"import": "./dist/zod-schema/index.js"
		}
	},
	"scripts": {
		"test": "vitest",
		"quality": "biome check .",
		"quality:fix": "biome check . --write --unsafe",

		"build": "react-router build",
		"cf-typegen": "wrangler types",
		"deploy": "npm run build && wrangler deploy",
		"dev": "react-router dev",
		"preview": "npm run build && vite preview",
		"typecheck": "npm run cf-typegen && react-router typegen && tsc -b"
	},
	"keywords": [
		"worker",
		"typescript",
		"cloudflare worker",
		"Hono",
		"Remix"
	],
	"author": "",
	"license": "MIT",
	"resolutions": {
		"sourcemap-codec": "@jridgewell/sourcemap-codec"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@react-router/dev": "^7.5.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/node": "^20.17.24",
		"@types/react": "^19.0.1",
		"@types/react-dom": "^19.0.1",
		"chokidar-cli": "^3.0.0",
		"drizzle-kit": "^0.30.6",
		"miniflare": "^4.20250310.0",
		"react-router-devtools": "^1.1.0",
		"tailwindcss": "^4.0.0",
		"tsup": "^8.3.6",
		"tsx": "^4.19.3",
		"typedoc": "^0.27.3",
		"typedoc-plugin-mdn-links": "^4.0.3",
		"typescript": "^5.7.2",
		"vite": "^6.2.4",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^3.1.1",
		"wrangler": "^4.2.0"
	},
	"dependencies": {
		"@cloudflare/vite-plugin": "^1.0.5",
		"@react-router/cloudflare": "^7.5.0",
		"@react-router/remix-routes-option-adapter": "^7.5.0",
		"@rollup/plugin-inject": "^5.0.5",
		"bcryptjs": "^3.0.2",
		"dotenv": "^16.4.7",
		"drizzle-orm": "^0.40.0",
		"hono": "^4.7.2",
		"isbot": "^5.1.17",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-router": "^7.5.0",
		"remix-hono": "^0.0.18",
		"rimraf": "^5.0.10"
	}
}
