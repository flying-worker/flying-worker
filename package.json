{
  "name": "flying-worker-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "flying-worker",
    "framework"
  ],
  "scripts": {
    "dev": "npm run dev -w framework",
    "build": "npm run build -w framework",
    "build:pkg": "npm run build -w flying-worker",
    "preview": "npm run preview -w framework",
    "db:generate": "npm run db:generate -w framework",
    "db:migrate": "npm run db:migrate:remote -w framework",
    "db:migrate:local": "npm run db:migrate -w framework",
    "db:studio": "npm run db:studio -w framework",
    "typecheck": "npm run typecheck -w flying-worker && npm run typecheck -w framework"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "tsup": {
      "esbuild": "^0.25.12"
    }
  },
  "allowScripts": {
    "workerd@1.20260714.1": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  }
}
