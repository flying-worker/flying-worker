{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Cloudflare Worker",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/wrangler/bin/wrangler.js",
      "args": ["dev", "--port", "8787", "--inspector-port", "9229"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "development"
      },
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**",
        "**/package/**"
      ]
    },
    {
      "name": "Debug React Router (Client)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/vite",
      "args": ["dev", "--port", "5173"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "Debug Tests",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/vitest",
      "args": ["run"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**",
        "**/package/**"
      ]
    }
  ]
}