{
  "folders": [
    {
      "name": "Flying Worker Framework",
      "path": "."
    }
  ],
  "settings": {
    // Framework-specific settings
    "typescript.preferences.includePackageJsonAutoImports": "on",
    "typescript.suggest.autoImports": true,
    
    // File exclusions to avoid package directory
    "files.exclude": {
      "**/package": true,
      "**/dist": true,
      "**/.react-router": true,
      "**/.wrangler": true,
      "**/migrations": true
    },
    
    // Search exclusions
    "search.exclude": {
      "**/package": true,
      "**/dist": true,
      "**/.react-router": true,
      "**/.wrangler": true,
      "**/migrations": true
    },
    
    // Default to Biome for formatting
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true,
    
    // Framework context
    "workbench.colorCustomizations": {
      "titleBar.activeBackground": "#FF2D20",
      "titleBar.activeForeground": "#FFFFFF"
    }
  },
  "extensions": {
    "recommendations": [
      "biomejs.biome",
      "cloudflare.vscode-cf-workers",
      "ms-vscode.vscode-typescript-next",
      "dsznajder.es7-react-js-snippets",
      "bradlc.vscode-tailwindcss",
      "aaron-bond.better-comments",
      "usernamehw.errorlens",
      "eamodio.gitlens"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Dev Server",
        "type": "shell",
        "command": "npm run dev",
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        },
        "isBackground": true
      }
    ]
  }
}