{
	"compilerOptions": {
		"target": "ES2019",
		"lib": ["ES2019", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler", // Add this if it's not already there
		"declaration": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"esModuleInterop": true
	},
	"include": ["src/**/*", "declarations.d.ts"],
	"exclude": ["dist"]
}
